import base64
from io import BytesIO
from docx import Document
from docx.shared import Inches
from PIL import Image
import tempfile
import os

# Base64-encoded image data (from uploaded file)
base64_image_data = """
iVBORw0KGgoAAAANSUhEUgAAAOEAAADhCAIAAADNXpEKAAAACXBIWXMAAAsSAAALEgHS3X78AAA
AAB3RJTUUH5AMIBCEiiDCysAAAABl0RVh0Q29tbWVudABDcmVhdGVkIHdpdGggR0lNUFeBDhcAA
AGGSURBVHja7NwxDsIgDEVRSdo+qWo9tZZEVHvRbaEbWTryAq4qWXfwAnSRkAAAAAAAAAAAAAA
AAAAAAAAAAAAAADv/E6L7HZ89DWLtqLgAAAAASUVORK5CYII=
"""

# Decode the Base64 string to binary data
image_data = base64.b64decode(base64_image_data)

# Save the binary image data to a temporary PNG file and verify with Pillow
with tempfile.NamedTemporaryFile(delete=False, suffix=".png") as tmp_file:
    temp_image_path = tmp_file.name  # Get the path to the temporary file
    tmp_file.write(image_data)

# Verify the image file with Pillow to ensure it's valid
try:
    with Image.open(temp_image_path) as img:
        img.verify()  # This will raise an exception if the image is not valid
    print("Image is a valid PNG.")

    # Create a new Document
    doc = Document()
    doc.add_paragraph("This is a test document with an embedded image.")

    # Embed the verified image file
    doc.add_picture(temp_image_path, width=Inches(2))  # Adjust width as desired
    print("Image successfully embedded.")

    # Save the document
    doc.save("C:/Users/ted.knapp/OneDrive - LogRhythm, Inc/Desktop/test_image_from_base64.docx")
    print("DOCX file saved as 'test_image_from_base64.docx'")

except Exception as e:
    print(f"Failed to verify or embed image: {e}")

finally:
    # Clean up the temporary fil

